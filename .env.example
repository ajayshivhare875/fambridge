# Create a new bot via @BotFather (a separate bot is recommended)
PAYBOT_TOKEN=your_bot_token_here
# Your Telegram numeric ID (becomes admin on /start)
ADMIN_ID=your_telegram_id
# Which email senders count as payment emails (comma separated)
PAY_EMAIL_SENDERS=fampay,famapp
# Order expiry time in minutes
ORDER_EXPIRY_MIN=15
# Gmail check interval (seconds)
POLL_INTERVAL_SEC=25
# Optional: your own Fernet key (auto-generated if empty)
# PAYMENTS_FERNET_KEY=
